model AttendanceEvent {
  id             String  @id @default(uuid())
  organizationId String
  employeeId     String
  workLocationId String?

  eventType AttendanceEventType
  channel   AttendanceChannel

  // Time the event actually happened on the capture device/channel.
  capturedAt DateTime

  // Time DeluxHR first received the event.
  receivedAt DateTime @default(now())

  // Populated when an offline-captured event is synchronized later.
  syncedAt   DateTime?
  syncStatus AttendanceEventSyncStatus @default(RECEIVED)

  // Optional evidence for channels that support location-assisted capture.
  latitude          Float?
  longitude         Float?
  locationAccuracyM Float?

  locationVerificationStatus AttendanceLocationVerificationStatus @default(NOT_REQUESTED)
  distanceFromWorkLocationM  Float?

  // Channel/device references. Never store passwords, PINs or tokens here.
  sourceReference String?
  deviceReference String?

  // Kiosk-generated UUID/idempotency key for an event captured while offline.
  // Scoped by organization + device so retries cannot create duplicates.
  offlineEventId String?

  // Optional non-sensitive evidence/diagnostic metadata.
  metadata Json?

  createdByUserId String?
  createdAt       DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee      @relation(fields: [employeeId], references: [id])
  workLocation WorkLocation? @relation(fields: [workLocationId], references: [id])

  attendanceCorrection AttendanceCorrection?

  @@unique([organizationId, deviceReference, offlineEventId])
  @@index([organizationId])
  @@index([employeeId])
  @@index([workLocationId])
  @@index([organizationId, employeeId, capturedAt])
  @@index([organizationId, workLocationId, capturedAt])
  @@index([capturedAt])
  @@index([channel])
  @@index([syncStatus])
  @@index([organizationId, deviceReference, offlineEventId])
}

