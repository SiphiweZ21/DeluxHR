  activeRequestId String? @unique
  organizationId String
  employeeId String
  employeeName String
  beneficiarySnapshot Json
  amountCents Int
  paymentReference String @unique
  status String @default("PENDING")
  bankReference String?
  resultEvidence String?
  resultBy String?
  resultAt DateTime?
  batch EarlyPayPayoutBatch @relation(fields:[batchId],references:[id],onDelete:Restrict)
  request EarlyPayRequest @relation(fields:[requestId],references:[id],onDelete:Restrict)
  @@index([requestId])
  @@index([organizationId])
  @@index([batchId,status])
}


