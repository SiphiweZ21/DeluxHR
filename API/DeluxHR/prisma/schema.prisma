generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  COMPANY_ADMIN
  EXECUTIVE
  HR_ADMIN
  PAYROLL_ADMIN
  MANAGER
  EMPLOYEE
}

enum Permission {
  MANAGE_COMPANY
  MANAGE_USERS
  MANAGE_ACCESS

  VIEW_EMPLOYEES
  MANAGE_EMPLOYEES
  ADD_EMPLOYEES
  APPROVE_EMPLOYEES

  VIEW_EMPLOYEE_DOCUMENTS
  MANAGE_EMPLOYEE_DOCUMENTS
  VERIFY_EMPLOYEE_DOCUMENTS

  VIEW_EMPLOYEE_PAYMENT_DETAILS
  MANAGE_EMPLOYEE_PAYMENT_DETAILS
  APPROVE_EMPLOYEE_PAYMENT_DETAILS

  VIEW_TEAM
  VIEW_SELF

  MANAGE_LEAVE
  VIEW_HR_REQUESTS
  MANAGE_HR_REQUESTS
  VIEW_COMMUNICATIONS
  MANAGE_COMMUNICATIONS
  APPROVE_TEAM_LEAVE
  REQUEST_LEAVE

  VIEW_ATTENDANCE
  MANAGE_ATTENDANCE
  APPROVE_TIMESHEETS

  VIEW_PAYROLL
  MANAGE_PAYROLL
  GENERATE_PAYROLL
  REVIEW_PAYROLL
  APPROVE_PAYROLL
  VIEW_ALL_PAYSLIPS

  PREPARE_PAYROLL_PAYMENTS
  APPROVE_PAYROLL_PAYMENTS
  EXPORT_PAYROLL_PAYMENTS
  CONFIRM_PAYROLL_PAYMENTS
  VIEW_OWN_PAYSLIP

  VIEW_EXECUTIVE_DASHBOARD
  VIEW_WORKFORCE_COST
  VIEW_WORKFORCE_INSIGHTS

  MANAGE_EARLY_PAY_POLICY
  APPROVE_EARLY_PAY
  REQUEST_EARLY_PAY

  VIEW_RISK_EVENTS
  MANAGE_RISK_EVENTS

  VIEW_AUDIT_LOGS
}

enum DataScope {
  SELF
  TEAM
  DEPARTMENT
  ORGANIZATION
}

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum Feature {
  CORE_HR
  LEAVE
  ATTENDANCE
  TIMESHEETS
  PAYROLL
  PAYSLIPS
  WHATSAPP
  EARLY_PAY
  WORKFORCE_INSIGHTS
  EXECUTIVE_DASHBOARD
}

enum AttendanceEventType {
  CHECK_IN
  CHECK_OUT
}

enum AttendanceExceptionType {
  MISSING_CHECK_IN
  MISSING_CHECK_OUT
  LATE_ARRIVAL
  EARLY_DEPARTURE
  EXPECTED_ABSENCE
  LOCATION_MISMATCH
}

enum AttendanceExceptionStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum AttendanceLocationVerificationStatus {
  NOT_REQUESTED
  NOT_CONFIGURED
  WITHIN_RADIUS
  OUTSIDE_RADIUS
}

enum AttendanceEventSyncStatus {
  RECEIVED
  SYNCED_OFFLINE
}

enum AttendanceChannel {
  WEB
  KIOSK
  QR
  WHATSAPP
  SUPERVISOR
}

enum WorkLocationType {
  HEAD_OFFICE
  BRANCH
  CALL_CENTRE
  WAREHOUSE
  CLIENT_SITE
  FIELD_SITE
  OTHER
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum OnboardingMode {
  SELF_SERVICE
  ASSISTED
}

enum EmployeeStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum IdentityType {
  SOUTH_AFRICAN_ID
  PASSPORT
  OTHER
}

enum EmploymentType {
  PERMANENT
  FIXED_TERM
  TEMPORARY
  PART_TIME
  CONTRACTOR
  INTERN
}

enum EmployeeDocumentType {
  ID_DOCUMENT
  PASSPORT
  EMPLOYMENT_CONTRACT
  PROOF_OF_BANKING
  TAX_DOCUMENT
  QUALIFICATION
  CERTIFICATE
  WORK_PERMIT
  VISA
  MEDICAL_CERTIFICATE
  OTHER
}

enum EmployeeDocumentStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum EmployeePaymentDetailStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUPERSEDED
}

enum EmployeeCompensationChangeStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum RiskEventType {
  DUPLICATE_IDENTITY
  DUPLICATE_EMPLOYEE
  SHARED_BANK_ACCOUNT
  PAYMENT_DETAILS_CHANGED
  SALARY_CHANGED
  RAPID_EMPLOYEE_ACTIVATION
  PAYROLL_ANOMALY
  TERMINATED_EMPLOYEE_PAYROLL_ATTEMPT
  OTHER
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskEventStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum EarningType {
  SALARY
  OVERTIME
  BONUS
  COMMISSION
  ALLOWANCE
  REIMBURSEMENT
  OTHER
}

enum PayrollItemStatus {
  PENDING
  APPROVED
  PROCESSED
  CANCELLED
}

enum PayrollRunStatus {
  DRAFT
  CALCULATED
  REVIEWED
  APPROVED
  LOCKED
  PAYMENT_PROCESSING
  PAID
  CANCELLED
}

enum PayrollBatchStatus {
  DRAFT
  GENERATING
  CALCULATED
  REVIEWED
  APPROVED
  LOCKED
  PAYMENT_PROCESSING
  PAID
  CANCELLED
}

enum PayrollBatchEmployeeEligibilityStatus {
  READY
  WARNING
  BLOCKED
}

enum PayrollBatchEmployeeProcessingStatus {
  PENDING
  GENERATING
  GENERATED
  FAILED
  SKIPPED
}

enum PayrollPaymentBatchStatus {
  PREPARED
  APPROVED_FOR_EXPORT
  EXPORTED
  SUBMITTED_TO_BANK
  PARTIALLY_PAID
  PAID
  FAILED
  CANCELLED
}

enum PayrollPaymentItemStatus {
  PREPARED
  EXPORTED
  SUBMITTED_TO_BANK
  PAID
  FAILED
  RETURNED
  CANCELLED
}

enum PayrollPaymentReconciliationStatus {
  UNRESOLVED
  MATCHED
  DIFFERENCE
}

enum PayrollPaymentMethod {
  BANK_FILE
}

enum PayrollApprovalMode {
  SINGLE_APPROVER
  MAKER_CHECKER
}

enum PayrollLedgerCategory {
  EARNING
  STATUTORY_DEDUCTION
  BENEFIT_DEDUCTION
  OTHER_DEDUCTION
  EARLY_PAY_RECOVERY
  EMPLOYER_CONTRIBUTION
  EMPLOYER_STATUTORY
  NET_PAY
}

enum PayrollLedgerEffect {
  EMPLOYEE_EARNING
  EMPLOYEE_DEDUCTION
  EMPLOYER_COST
  EMPLOYER_LIABILITY
  NET_SETTLEMENT
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  LOCKED
}

enum LeaveApproverKind {
  MANAGER
  HR
}
enum LeaveDecisionStatus {
  PENDING
  APPROVED
  REJECTED
}
enum LeaveDocumentKind {
  SUPPORTING
  MEDICAL_CERTIFICATE
}
enum LeaveChangeKind {
  CANCELLATION
  AMENDMENT
}
enum LeaveChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveAccrualMode {
  ANNUAL_UPFRONT
  MONTHLY
}

enum LeaveBalanceAdjustmentType {
  OPENING
  CREDIT
  DEBIT
}

enum OvertimeApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayslipStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum EarlyPayRequestStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  PAID
  PAYMENT_FAILED
  CANCELLED
  RECOVERED
}

enum EarlyPayTransferType {
  STANDARD
  INSTANT
}

model Organization {
 companyDocuments CompanyOnboardingDocument[]
  id     String             @id @default(uuid())
  name   String
  status OrganizationStatus @default(PENDING)

  legalName          String?
  registrationNumber String?
  taxNumber          String?
  email              String?
  phoneNumber        String?
  website            String?
  logoStorageKey     String?
  brandPrimaryColor String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  province     String?
  postalCode   String?
  country      String? @default("South Africa")
  timezone     String? @default("Africa/Johannesburg")

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  repaymentBatches            EarlyPayRepaymentBatch[]
  remittanceBeneficiaries RemittanceBeneficiary[]
  remittanceBatches RemittancePaymentBatch[]
  bankingProfiles             CompanyBankingProfile[]
  bankingDefaults             CompanyBankingDefault[]
  users                       User[]
  userPermissions             UserPermission[]
  features                    OrganizationFeature[]
  departments                 Department[]
  employees                   Employee[]
  leaveTypes                  LeaveType[]
  leavePolicies               LeavePolicy[]
  leavePolicyAssignments      EmployeeLeavePolicyAssignment[]
  leaveBalanceAdjustments     LeaveBalanceAdjustment[]
  publicHolidays              CompanyPublicHoliday[]
  leaveWorkflows              LeaveApprovalWorkflow[]
  leaveDelegations            LeaveApprovalDelegation[]
  leaveDocuments              LeaveDocument[]
  leaveNotifications          LeaveNotification[]
  whatsappEssIdentities        WhatsAppEssIdentity[]
  whatsappEssSessions          WhatsAppEssSession[]
  hrRequests                   HrServiceRequest[]
  hrRequestCategories          HrRequestCategory[]
  workforceAnnouncements       WorkforceAnnouncement[]
  liabilityAdjustments          PayrollLiabilityAdjustment[]
  remittancePayments            PayrollRemittancePayment[]
  communicationTeams            CommunicationTeam[]
  payslipAccessLinks           PayslipAccessLink[]
  leaveReqs                   LeaveRequest[]
  earnings                    Earning[]
  payrollBatches              PayrollBatch[]
  payrollPaymentBatches       PayrollPaymentBatch[]
  payrollPaymentItems         PayrollPaymentItem[]
  payrollRuns                 PayrollRun[]
  timesheets                  Timesheet[]
  overtimePolicy              OvertimePolicy?
  overtimeApprovals           OvertimeApproval[]
  payrollPeriodLocks          PayrollPeriodLock[]
  attendanceExceptions        AttendanceException[]
  attendanceRecords           AttendanceRecord[]
  attendanceEvents            AttendanceEvent[]
  attendanceIdentities        EmployeeAttendanceIdentity[]
  attendanceKiosks            AttendanceKiosk[]
  attendancePolicies          AttendancePolicy[]
  shifts                      ShiftDefinition[]
  shiftAssignments            ShiftAssignment[]
  recurringSchedules          RecurringSchedule[]
  workLocations               WorkLocation[]
  workLocationAssignments     EmployeeWorkLocationAssignment[]
  auditLogs                   AuditLog[]
  payslips                    Payslip[]
  earlyPayPolicy              EarlyPayPolicy?
  earlyPayRequests            EarlyPayRequest[]
  payrollSettings             PayrollSettings?
  payrollProfiles             EmployeePayrollProfile[]
  benefitPlans                BenefitPlan[]
  employeeBenefits            EmployeeBenefit[]
  payrollDeductionDefinitions PayrollDeductionDefinition[]
  employeeDeductions          EmployeeDeduction[]
  payrollLedgerEntries        PayrollLedgerEntry[]
  employeeDocuments           EmployeeDocument[]
  employeePaymentDetails      EmployeePaymentDetail[]
  employeeCompensationChanges EmployeeCompensationChange[]
  riskEvents                  RiskEvent[]

  onboarding            OrganizationOnboarding?
  payrollBatchEmployees PayrollBatchEmployee[]
  attendanceCorrections AttendanceCorrection[]
  platformSubscription PlatformSubscription?
  supportSessions PlatformSupportSession[]
  onboardingConfirmations OnboardingConfirmation[]

  @@index([status])
}

model OrganizationOnboarding {
  id             String           @id @default(uuid())
  organizationId String           @unique
  status         OnboardingStatus @default(NOT_STARTED)
  mode           OnboardingMode   @default(SELF_SERVICE)

  companyProfileComplete Boolean @default(false)
  departmentsComplete    Boolean @default(false)
  accessSetupComplete    Boolean @default(false)

  assistanceRequested Boolean @default(false)

  startedAt         DateTime?
  completedAt       DateTime?
  completedByUserId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([mode])
  @@index([assistanceRequested])
}

model OnboardingConfirmation {
  id String @id @default(uuid())
  organizationId String
  step String
  confirmedByUserId String
  note String?
  confirmedAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, step])
}

model OrganizationFeature {
  id             String    @id @default(uuid())
  organizationId String
  feature        Feature
  enabled        Boolean   @default(true)
  enabledAt      DateTime  @default(now())
  disabledAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, feature])
  @@index([organizationId])
  @@index([feature])
  @@index([enabled])
}

model PlatformPackage {
  id String @id @default(uuid())
  code String @unique
  name String
  description String?
  features Feature[]
  employeeLimit Int?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  subscriptions PlatformSubscription[]
}

model PlatformSubscription {
  id String @id @default(uuid())
  organizationId String @unique
  packageId String
  status String @default("ACTIVE")
  startsAt DateTime @default(now())
  endsAt DateTime?
  changedByUserId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  package PlatformPackage @relation(fields: [packageId], references: [id])
  @@index([packageId, status])
}

model PlatformSupportSession {
  id String @id @default(uuid())
  organizationId String
  targetUserId String
  actorUserId String
  reason String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([actorUserId, expiresAt])
  @@index([organizationId, expiresAt])
}

model PlatformConfiguration {
  key String @id
  value String
  updatedByUserId String
  updatedAt DateTime @updatedAt
}

model PlatformAuditEvent {
  id String @id @default(uuid())
  actorUserId String
  action String
  entity String
  entityId String
  organizationId String?
  reason String?
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([organizationId, createdAt])
}

model User {
  id             String   @id @default(uuid())
  fullName       String
  email          String   @unique
  passwordHash   String
  role           UserRole
  isActive       Boolean  @default(true)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee?
  permissions  UserPermission[]

  @@index([organizationId])
  @@index([role])
}

model UserPermission {
  id             String     @id @default(uuid())
  userId         String
  organizationId String
  permission     Permission
  scope          DataScope
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @default(now()) @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([organizationId])
  @@index([userId])
  @@index([permission])
}

model Department {
  positions Position[]
  id             String   @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employees    Employee[]
  shiftAssignments ShiftAssignment[]
  recurringSchedules RecurringSchedule[]

  @@unique([organizationId,id])
  @@unique([organizationId, name])
  @@index([organizationId])
}

model Employee {
  positionId String?
  position Position? @relation(fields:[organizationId,departmentId,positionId],references:[organizationId,departmentId,id],onDelete:Restrict)
  id              String  @id @default(uuid())
  employeeNumber  String
  firstName       String
  lastName        String
  email           String
  organizationId  String
  departmentId    String
  userId          String? @unique
  createdByUserId String?

  status              EmployeeStatus  @default(PENDING_VERIFICATION)
  jobTitle            String?
  employmentType      EmploymentType?
  employmentStartDate DateTime?
  employmentEndDate   DateTime?

  identityType   IdentityType?
  identityNumber String?

  verifiedAt        DateTime?
  verifiedByUserId  String?
  activatedAt       DateTime?
  activatedByUserId String?

  terminatedAt      DateTime?
  terminationReason String?

  phoneNumber     String?
  whatsappNumber  String?
  whatsappOptInAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  organization            Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  department              Department                       @relation(fields: [departmentId], references: [id])
  user                    User?                            @relation(fields: [userId], references: [id])
  leaveRequests           LeaveRequest[]
  leavePolicyAssignments EmployeeLeavePolicyAssignment[]
  leaveBalanceAdjustments LeaveBalanceAdjustment[]
  earnings                Earning[]
  payrollRuns             PayrollRun[]
  payrollBatchEmployees   PayrollBatchEmployee[]
  timesheets              Timesheet[]
  overtimeApprovals       OvertimeApproval[]
  attendanceRecords       AttendanceRecord[]
  payslips                Payslip[]
  payslipDeliveries       PayslipDelivery[]
  earlyPayRequests        EarlyPayRequest[]
  ledgerEntries           PayrollLedgerEntry[]
  payrollProfile          EmployeePayrollProfile?
  documents               EmployeeDocument[]
  paymentDetails          EmployeePaymentDetail[]
  compensationChanges     EmployeeCompensationChange[]
  riskEvents              RiskEvent[]
  payrollPaymentItems     PayrollPaymentItem[]
  workLocationAssignments EmployeeWorkLocationAssignment[]
  attendanceEvents        AttendanceEvent[]
  attendanceIdentity      EmployeeAttendanceIdentity?
  attendanceExceptions    AttendanceException[]
  attendanceCorrections   AttendanceCorrection[]
  shiftAssignments        ShiftAssignment[]
  recurringSchedules      RecurringSchedule[]
  whatsappEssIdentity     WhatsAppEssIdentity?
  whatsappEssSessions     WhatsAppEssSession[]
  hrServiceRequests       HrServiceRequest[]
  communicationMemberships CommunicationTeamMember[]
  announcementReceipts AnnouncementReceipt[]
  payslipAccessLinks      PayslipAccessLink[]

  complianceDocuments CompanyOnboardingDocument[]
  @@unique([organizationId,id])
  @@unique([organizationId, email])
  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([departmentId])
  @@index([organizationId, status])
  @@index([organizationId, identityNumber])
  @@index([organizationId, createdByUserId])
}

model LeaveType {
  id             String   @id @default(uuid())
  name           String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]
  policies LeavePolicy[]
  policyAssignments EmployeeLeavePolicyAssignment[]
  balanceAdjustments LeaveBalanceAdjustment[]
  approvalWorkflows LeaveApprovalWorkflow[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model LeaveRequest {
  id             String   @id @default(uuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  status         String
  chargedDays    Float?
  chargeBreakdown Json?
  policyId       String?
  approvalWorkflowId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  leaveType    LeaveType    @relation(fields: [leaveTypeId], references: [id])
  policy       LeavePolicy? @relation(fields: [policyId], references: [id])
  approvalWorkflow LeaveApprovalWorkflow? @relation(fields: [approvalWorkflowId], references: [id])
  decisions LeaveApprovalDecision[]
  documents LeaveDocument[]
  comments LeaveComment[]
  changes LeaveChangeRequest[]

  @@index([organizationId])
  @@index([employeeId])
  @@index([leaveTypeId])
}

model AuditLog {
  id             String @id @default(uuid())
  action         String
  entity         String
  entityId       String
  organizationId String

  actorUserId String?
  actorEmail  String?
  actorRole   UserRole?
  reason      String?
  metadata    Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([actorUserId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model Earning {
  id             String  @id @default(uuid())
  organizationId String
  employeeId     String
  payrollRunId   String?

  title  String
  type   EarningType
  source String?

  payPeriodStart DateTime
  payPeriodEnd   DateTime
  earnedDate     DateTime

  units    Float?
  rate     Float?
  amount   Float
  currency String @default("ZAR")

  status PayrollItemStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee     @relation(fields: [employeeId], references: [id])
  payrollRun   PayrollRun?  @relation(fields: [payrollRunId], references: [id])

  @@index([organizationId])
  @@index([employeeId])
  @@index([payrollRunId])
  @@index([status])
  @@index([payPeriodStart, payPeriodEnd])
}

model PayrollBatch {
  id             String @id @default(uuid())
  organizationId String

  title          String?
  payPeriodStart DateTime
  payPeriodEnd   DateTime
  paymentDate    DateTime?
  currency       String    @default("ZAR")

  status PayrollBatchStatus @default(DRAFT)
  notes  String?

  createdByUserId String?

  generationStartedByUserId String?
  generationStartedAt       DateTime?
  calculatedAt              DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?

  approvedByUserId String?
  approvedAt       DateTime?

  lockedByUserId String?
  lockedAt       DateTime?

  paymentProcessingByUserId String?
  paymentProcessingAt       DateTime?

  paidByUserId String?
  paidAt       DateTime?

  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id])
  payrollRuns    PayrollRun[]
  batchEmployees PayrollBatchEmployee[]
  paymentBatches PayrollPaymentBatch[]

  @@unique([organizationId, payPeriodStart, payPeriodEnd])
  @@index([organizationId])
  @@index([status])
  @@index([payPeriodStart, payPeriodEnd])
  @@index([paymentDate])
  @@index([createdAt])
}

model PayrollBatchEmployee {
  id             String  @id @default(uuid())
  organizationId String
  payrollBatchId String
  employeeId     String
  payrollRunId   String? @unique

  eligibilityStatus PayrollBatchEmployeeEligibilityStatus
  processingStatus  PayrollBatchEmployeeProcessingStatus  @default(PENDING)

  eligibilityReasons  Json?
  eligibilityWarnings Json?

  generationAttemptCount  Int       @default(0)
  lastGenerationAttemptAt DateTime?
  lastGenerationError     String?
  generatedAt             DateTime?

  reviewedByUserId String?
  reviewedAt       DateTime?

  resolvedByUserId String?
  resolvedAt       DateTime?
  resolutionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  payrollBatch PayrollBatch @relation(fields: [payrollBatchId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  payrollRun   PayrollRun?  @relation(fields: [payrollRunId], references: [id])

  @@unique([payrollBatchId, employeeId])
  @@index([organizationId])
  @@index([payrollBatchId])
  @@index([employeeId])
  @@index([eligibilityStatus])
  @@index([processingStatus])
  @@index([payrollBatchId, eligibilityStatus])
  @@index([payrollBatchId, processingStatus])
  @@index([createdAt])
}

model PayrollPaymentBatch {
  id             String @id @default(uuid())
  organizationId String
  payrollBatchId String

  method   PayrollPaymentMethod      @default(BANK_FILE)
  status   PayrollPaymentBatchStatus @default(PREPARED)
  currency String                    @default("ZAR")

  employeeCount Int   @default(0)
  totalAmount   Float @default(0)

  preparedByUserId String
  preparedAt       DateTime @default(now())

  approvedForExportByUserId String?
  approvedForExportAt       DateTime?

  exportedByUserId String?
  exportedAt       DateTime?
  exportReference  String?
  exportFileName   String?
  fundingProfileId String?
  fundingSnapshot Json?
  paymentDateSnapshot DateTime?
  exportAdapterId String?
  exportContentType String?
  exportSha256 String?
  exportFileBytes Bytes?

  submittedToBankByUserId String?
  submittedToBankAt       DateTime?
  bankSubmissionReference String?

  paidByUserId String?
  paidAt       DateTime?

  failedAt      DateTime?
  failureReason String?

  cancelledByUserId  String?
  cancelledAt        DateTime?
  cancellationReason String?

  reconciliationStatus     PayrollPaymentReconciliationStatus @default(UNRESOLVED)
  reconciledByUserId       String?
  reconciledAt             DateTime?
  reconciledExpectedAmount Float?
