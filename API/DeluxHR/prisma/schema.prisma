enum PayFrequency {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
}

enum BenefitType {
  RETIREMENT_FUND
  MEDICAL_AID
  OTHER
}

enum ContributionMethod {
  NONE
  FIXED_AMOUNT
  PERCENTAGE
}

enum ContributionBasis {
  BASIC_SALARY
  PENSIONABLE_SALARY
  CUSTOM
